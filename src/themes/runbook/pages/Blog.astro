---
import Layout from '../Layout.astro';
import { copy } from '../../../data/home';
import { altLangUrl, formatDate, getPosts, postUrl, readingTime, url, type Lang } from '../../../lib/routes';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = copy[lang];
const posts = await getPosts(lang);

// assuntos dos filtros: as tags dos posts são livres (caixa e idioma variam), então cada assunto junta as que tratam dele
const topics: { id: string; label: { pt: string; en: string }; tags: string[] }[] = [
  { id: 'homelab', label: { pt: 'Homelab', en: 'Homelab' }, tags: ['homelab'] },
  { id: 'terraform', label: { pt: 'Terraform', en: 'Terraform' }, tags: ['terraform'] },
  { id: 'ansible', label: { pt: 'Ansible', en: 'Ansible' }, tags: ['ansible'] },
  { id: 'proxmox', label: { pt: 'Proxmox', en: 'Proxmox' }, tags: ['proxmox', 'lvm-thin'] },
  { id: 'kubernetes', label: { pt: 'Kubernetes e GitOps', en: 'Kubernetes & GitOps' }, tags: ['kubernetes', 'k3s', 'argocd', 'gitops'] },
  { id: 'storage', label: { pt: 'Storage e backup', en: 'Storage & backup' }, tags: ['truenas', 'nfs', 'storage', 'smart', 'backup', 'disaster recovery'] },
  { id: 'network', label: { pt: 'Redes', en: 'Networking' }, tags: ['networking', 'opnsense', 'vlan', 'tailscale'] },
  { id: 'aws', label: { pt: 'AWS', en: 'AWS' }, tags: ['aws'] },
  { id: 'cicd', label: { pt: 'CI/CD', en: 'CI/CD' }, tags: ['ci/cd', 'github actions'] },
  { id: 'troubleshooting', label: { pt: 'Troubleshooting', en: 'Troubleshooting' }, tags: ['troubleshooting'] },
];
const topicsOf = (tags: string[]) => {
  const t = tags.map((x) => x.toLowerCase());
  return topics.filter((tp) => tp.tags.some((x) => t.includes(x))).map((tp) => tp.id);
};
// assunto com um post só não ajuda a filtrar
const filters = topics
  .map((tp) => ({ ...tp, n: posts.filter((p) => topicsOf(p.data.tags).includes(tp.id)).length }))
  .filter((tp) => tp.n >= 2);
const t = lang === 'pt'
  ? { label: 'Filtrar por assunto', all: 'Todos' }
  : { label: 'Filter by topic', all: 'All' };
---

<Layout lang={lang} active="blog" title={c.blog.title} altHref={altLangUrl(lang, 'blog')}>
  <div class="wrap page">
    <a class="lnk crumb" href={url(lang, 'home')}>← {c.blog.home}</a>
    <h1>{c.blog.title}</h1>
    <p class="lead">{c.blog.lead}</p>
    <div class="filters" role="group" aria-label={t.label}>
      <button type="button" class="chip" data-topic="" aria-pressed="true">{t.all} <span>{posts.length}</span></button>
      {filters.map((f) => <button type="button" class="chip" data-topic={f.id} aria-pressed="false">{f.label[lang]} <span>{f.n}</span></button>)}
    </div>
    <ul class="list">
      {posts.map((p) => (
        <li data-topics={topicsOf(p.data.tags).join(' ')}>
          <time class="mono" datetime={p.data.date.toISOString()}>{formatDate(p.data.date, lang)}</time>
          <div>
            <h2><a href={postUrl(p)}>{p.data.title}</a></h2>
            <p>{p.data.description}</p>
            <p class="tag-list">{p.data.tags.map((x) => <span>{x.toLowerCase()}</span>)}</p>
          </div>
          <span class="mono rt">{readingTime(p)} {c.blog.minRead}</span>
        </li>
      ))}
    </ul>
  </div>
</Layout>

<script>
  // filtro só no navegador; o assunto vai para ?t= para o link poder ser compartilhado
  const chips = [...document.querySelectorAll<HTMLButtonElement>('.filters .chip')];
  const items = [...document.querySelectorAll<HTMLLIElement>('.list li[data-topics]')];
  const apply = (topic: string) => {
    if (topic && !chips.some((c) => c.dataset.topic === topic)) topic = '';
    chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.topic === topic)));
    items.forEach((li) => { li.hidden = !!topic && !li.dataset.topics!.split(' ').includes(topic); });
    const u = new URL(location.href);
    if (topic) u.searchParams.set('t', topic); else u.searchParams.delete('t');
    history.replaceState(null, '', u);
  };
  chips.forEach((c) => c.addEventListener('click', () => apply(c.getAttribute('aria-pressed') === 'true' ? '' : c.dataset.topic!)));
  apply(new URL(location.href).searchParams.get('t') ?? '');
</script>

<style>
  .filters { display: none; margin-top: 24px; flex-wrap: wrap; gap: 4px 6px; }
  :global(html.js) .filters { display: flex; }
  .chip { font: 400 .72rem var(--mono); color: var(--ink-3); background: transparent; border: 1px solid var(--rule); border-radius: 999px; padding: 2px 9px; cursor: pointer; }
  .chip span { opacity: .7; margin-left: 1px; }
  .chip:hover { color: var(--ink); border-color: var(--rule-strong); }
  .chip[aria-pressed='true'] { color: var(--signal); border-color: currentColor; }
  .chip:focus-visible { outline: 2px solid var(--signal); outline-offset: 2px; }
  .list li[hidden] { display: none; }
  .page { padding-block: 32px 72px; max-width: 1040px; }
  .crumb { font-size: .9rem; }
  h1 { margin-top: 20px; font: 700 clamp(2.6rem, 8vw, 5rem)/1 var(--display); font-stretch: 116%; letter-spacing: -.03em; }
  .lead { margin-top: 14px; max-width: 36em; font-size: 1.1rem; }
  .list { margin-top: 24px; border-top: 1px solid var(--rule-strong); }
  .list li { display: grid; grid-template-columns: 8em minmax(0, 1fr) auto; gap: 6px 24px; padding-block: 22px; border-bottom: 1px solid var(--rule); }
  time, .rt { font-size: .8rem; line-height: 2.2; color: var(--ink-3); }
  h2 { font: 600 1.25rem/1.3 var(--sans); }
  h2 a { text-decoration: none; }
  h2 a:hover { color: var(--signal); }
  .list p { margin-top: 6px; }
  .tag-list { margin-top: 10px !important; }
  @media (max-width: 680px) { .list li { grid-template-columns: minmax(0, 1fr); } .rt { display: none; } }
</style>
